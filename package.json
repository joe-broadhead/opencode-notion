{
  "name": "@joe-broadhead/opencode-notion",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial OpenCode plugin for Notion: search, read and edit your workspace's pages, databases, comments and files through Notion's official MCP server",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "notion"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-notion.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-notion#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-notion/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
