      "mcp:notion-read-session-event": {
        "class": "read",
        "accounts": "none",
        "effect": "ask"
      },
      "mcp:notion-resolve-suggested-edit": {
        "class": "write",
        "accounts": "none"
      },
      "mcp:notion-restore-pages": {
        "class": "write",
        "accounts": "none"
      },
      "mcp:notion-restore-version": {
        "class": "delete",
        "accounts": "none"
      },
      "mcp:notion-search": {
        "class": "read",
        "accounts": "none"
      },
      "mcp:notion-search-agents": {
        "class": "read",
        "accounts": "none"
      },
      "mcp:notion-search-sessions": {
        "class": "read",
        "accounts": "none",
        "effect": "ask"
      },
      "mcp:notion-send-message-to-session": {
        "class": "send",
        "accounts": "none"
      },
      "mcp:notion-set-comment-reaction": {
        "class": "send",
        "accounts": "none"
      },
      "mcp:notion-set-discussion-resolved": {
        "class": "write",
