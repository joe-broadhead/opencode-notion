      },
      "mcp:notion-update-comment": {
        "class": "send",
        "accounts": "none"
      },
      "mcp:notion-update-data-source": {
        "class": "write",
        "accounts": "none"
      },
      "mcp:notion-update-folder": {
        "class": "write",
        "accounts": "none"
      },
      "mcp:notion-update-page": {
        "class": "write",
        "accounts": "none"
      },
      "mcp:notion-update-page-favorites": {
        "class": "write",
        "accounts": "none"
      },
      "mcp:notion-update-sidebar-tabs": {
        "class": "write",
        "accounts": "none"
      },
      "mcp:notion-update-skill-settings": {
        "class": "admin",
        "accounts": "none"
      },
      "mcp:notion-update-view": {
        "class": "write",
        "accounts": "none"
      },
      "mcp:notion-upload-skill": {
        "class": "admin",
        "accounts": "none"
      },
      "mcp:notion-view-version": {
        "class": "read",
        "accounts": "none"
      },
      "mcp:notion-wait-session": {
        "class": "read",
        "accounts": "none"
      }
    },
    "sources": [
      {
        "id": "notion.pages",
        "kind": "events",
        "reads": "doc",
        "method": "events_list",
        "input": {
          "source": "pages"
        },
        "service": {
          "id": "notion.pages",
          "label": "Notion pages"
        },
        "operations": [
          "notion-get-self",
          "notion-search"
        ],
        "cadence": {
          "suggestMinutes": 10
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 65536,
        "urlHosts": [
          "app.notion.com",
          "notion.so",
          "www.notion.so"
        ]
      }
    ],
    "actions": [],
    "events": {
      "account": {}
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint .",
    "test": "vitest run test/unit test/conformance test/host",
    "test:pack": "vitest run test/pack",
    "docs": "npx plugin-kit docs",
    "check": "npm run lint && npm run typecheck && npm run bundle && git diff --exit-code dist/ && npx plugin-kit docs --check && npm run test && npx plugin-kit check && npm run test:pack",
    "bundle": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/plugin-contract": "github:we-the-rebel-alliance/plugin-contract#v0.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
